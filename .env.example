# Copy locally to .env. Never commit real credentials.
DATABASE_URL=
# Neon direct/unpooled connection for migrations; optional for local PostgreSQL.
DIRECT_DATABASE_URL=
# Generate independently on each PC: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
API_PORT=4000
NODE_ENV=development
# Self-service password reset email (Resend). Leave empty until configured.
RESEND_API_KEY=
MAIL_FROM=
PASSWORD_RESET_ORIGIN=http://localhost:5173

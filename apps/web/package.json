{
  "name": "@unit111/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.json && vite build --configLoader runner",
